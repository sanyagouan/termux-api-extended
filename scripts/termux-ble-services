#!/data/data/com.termux/files/usr/bin/sh
# termux-ble-services - List services of connected BLE device
# Usage: termux-ble-services MAC_ADDRESS
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

ADDRESS="$1"
if [ -z "$ADDRESS" ]; then
    echo "Usage: termux-ble-services MAC_ADDRESS"
    exit 1
fi

REQUEST_ID="ble_svc_$(date +%s%N)"
JSON='{"id":"'$REQUEST_ID'","method":"ble.services","params":{"address":"'$ADDRESS'"}}'
send_command "$JSON" | pretty_json

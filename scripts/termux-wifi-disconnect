#!/data/data/com.termux/files/usr/bin/sh
# termux-wifi-disconnect - Disconnect from current WiFi network
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

REQUEST_ID="wifi_disc_$(date +%s%N)"
JSON='{"id":"'$REQUEST_ID'","method":"wifi.disconnect","params":{}}'
send_command "$JSON" | pretty_json

#!/data/data/com.termux/files/usr/bin/sh
# termux-bluetooth-connect - Connect to a paired Bluetooth device
# Usage: termux-bluetooth-connect MAC_ADDRESS [-p PROFILE]
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

ADDRESS="$1"
PROFILE=""

if [ -z "$ADDRESS" ]; then
    echo "Usage: termux-bluetooth-connect MAC_ADDRESS [-p PROFILE]"
    exit 1
fi

shift
while [ $# -gt 0 ]; do
    case "$1" in
        -p) PROFILE="$2"; shift 2 ;;
    esac
done

REQUEST_ID="bt_conn_$(date +%s%N)"
PROF=""
[ -n "$PROFILE" ] && PROF='"profile":"'$PROFILE'",'

JSON='{"id":"'$REQUEST_ID'","method":"bt.connect","params":{"address":"'$ADDRESS'",'$PROF'}}'
send_command "$JSON" | pretty_json

#!/data/data/com.termux/files/usr/bin/sh
# termux-bluetooth-list - List paired Bluetooth devices
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

REQUEST_ID="bt_list_$(date +%s%N)"
JSON='{"id":"'$REQUEST_ID'","method":"bt.pair.paired","params":{}}'
send_command "$JSON" | pretty_json

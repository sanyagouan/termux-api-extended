#!/data/data/com.termux/files/usr/bin/sh
# termux-wifi-saved - List saved WiFi networks
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

REQUEST_ID="wifi_saved_$(date +%s%N)"
JSON='{"id":"'$REQUEST_ID'","method":"wifi.networks.saved","params":{}}'
send_command "$JSON" | pretty_json

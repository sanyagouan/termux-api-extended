#!/data/data/com.termux/files/usr/bin/sh
# termux-bluetooth-disconnect - Disconnect a Bluetooth device
# Usage: termux-bluetooth-disconnect MAC_ADDRESS
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/termux-api-ext"

ADDRESS="$1"
if [ -z "$ADDRESS" ]; then
    echo "Usage: termux-bluetooth-disconnect MAC_ADDRESS"
    exit 1
fi

REQUEST_ID="bt_disc_$(date +%s%N)"
JSON='{"id":"'$REQUEST_ID'","method":"bt.disconnect","params":{"address":"'$ADDRESS'"}}'
send_command "$JSON" | pretty_json
